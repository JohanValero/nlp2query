      "foreign_keys": [
        {"fields": ["CompraID"], "references": {"table": "ComprasProveedores", "fields": ["CompraID"]}},
        {"fields": ["ProductoID"], "references": {"table": "Productos", "fields": ["ProductoID"]}}
      ]
    },
    {
