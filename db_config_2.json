      "foreign_keys": [
        { "fields": ["FacturaID"], "references": { "table": "Facturas", "fields": ["FacturaID"] } },
        { "fields": ["ProductoID"], "references": { "table": "Productos", "fields": ["ProductoID"] } }
      ]
    },
    {
      "name": "Pagos",
