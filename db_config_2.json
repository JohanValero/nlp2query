        { "name": "EstadoPago", "type": "VARCHAR(20)" }
      ],
      "foreign_keys": [{ "fields": ["ClienteID"], "references": { "table": "Clientes", "fields": ["ClienteID"] } }]
    },
    {
      "name": "DetallesFactura",
      "fields": [
        { "name": "DetalleID", "type": "INTEGER", "primary_key": true },
